# PostgreSQL connection (Supabase or local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cypherverse

# Supabase (optional - for Supabase Auth / Realtime later)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# AI Chatbot (Groq - free at console.groq.com)
GROQ_API_KEY=your-groq-api-key

# Server
PORT=3001
NODE_ENV=development
